{
  "name": "matrix",
  "version": "1.0.0",
  "description": "MATRIX - personal finance for Windows. Data stays on your PC.",
  "main": "main.js",
  "author": "MATRIX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.matrix",
    "productName": "MATRIX",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "icon-white.ico",
      "icon-black.ico",
      "icon-white.png",
      "icon-black.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "MATRIX"
    }
  },
  "productName": "MATRIX"
}